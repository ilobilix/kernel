    enum function_key : std::uint8_t
    {
        fn_find = 20,
        fn_insert,
        fn_remove,
        fn_select,
        fn_page_up,
        fn_page_down
    };

    enum cursor_key : std::uint8_t
    {
        cur_down,
        cur_left,
        cur_right,
        cur_up,
        cur_count
    };

    constexpr std::uint16_t key(ktype type, std::uint8_t val)
    {
        return static_cast<std::uint16_t>(type << 8) | val;
    }

    constexpr std::uint8_t key_type(std::uint16_t key)
    {
        return static_cast<ktype>(key >> 8);
    }

    constexpr std::uint8_t key_val(std::uint16_t key)
    {
        return key & 0xFF;
    }

    constexpr std::uint16_t key_uni(std::uint16_t key)
    {
        return key ^ 0xF000;
    }

    enum keys
    {
        k_hole = key(kt_spec, 0),
        k_shift = key(kt_shift, kg_shift),
        k_capsshift = key(kt_shift, kg_capsshift)
    };

