    enum ktype : std::uint8_t
    {
        kt_latin = 0,
        kt_fn = 1,
        kt_spec = 2,
        kt_pad = 3,
        kt_dead = 4,
        kt_cons = 5,
        kt_cur = 6,
        kt_shift = 7,
        kt_meta = 8,
